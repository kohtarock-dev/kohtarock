# === データベース ===
DATABASE_URL=sqlite:///./data/app.db

# === 楽天市場 商品検索API ===
# https://webservice.rakuten.co.jp/ で取得(無料)
# 2026年2月のAPI移行以降は、アプリケーションID(applicationId)に加えて
# Access key(accessKey)も必要です。「アプリ情報の確認」の詳細画面に両方表示されています。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# === Yahoo!ショッピング 商品検索API ===
# https://developer.yahoo.co.jp/ で取得(無料)
YAHOO_APP_ID=

# === Telegram Bot API ===
# LINE公式アカウントは無料枠が月200通までと実用的でなかったため、
# 完全無料・通数制限の無いTelegramに切り替えて使用しています。
# 1. Telegramで @BotFather に /newbot を送りBotを作成、トークンを取得
# 2. 作成したBotとのチャットを開始(何かメッセージを送っておく)
# 3. https://api.telegram.org/bot<トークン>/getUpdates にブラウザでアクセスし、
#    自分の chat.id を確認する
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === (使わなくなったが設定は残せる) LINE Messaging API ===
# LINE Notifyは2025年3月末で廃止済み。公式アカウント(Messaging API)経由の
# broadcast通知は app/notify/line.py に実装済みだが、現在は使用していない。
# 使いたい場合は scripts/ci_poll.py と app/scheduler.py のimportを
# app.notify.telegram から app.notify.line に戻してください。
LINE_CHANNEL_ACCESS_TOKEN=

# === Webアプリ ===
APP_HOST=0.0.0.0
APP_PORT=8000
# 巡回間隔のデフォルト(秒)。config/sources.yaml の各ソースで上書き可能
DEFAULT_POLL_INTERVAL_SEC=900
