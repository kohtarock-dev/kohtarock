# === データベース ===
DATABASE_URL=sqlite:///./data/app.db

# === 楽天市場 商品検索API ===
# https://webservice.rakuten.co.jp/ で取得(無料)
# 2026年2月のAPI移行以降は、アプリケーションID(applicationId)に加えて
# Access key(accessKey)も必要です。「アプリ情報の確認」の詳細画面に両方表示されています。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# === Yahoo!ショッピング 商品検索API ===
# https://developer.yahoo.co.jp/ で取得(無料)
YAHOO_APP_ID=

# === LINE Messaging API ===
# LINE Notifyは2025年3月末で廃止済みのため、公式アカウント(Messaging API)経由で通知します。
# 1. https://developers.line.biz/console/ で Messaging API チャネルを作成
# 2. チャネルアクセストークン(長期)を発行してここに設定
# 3. 通知を受け取りたい自分のLINEユーザーIDを設定(公式アカウントを友だち追加後、
#    Webhookログや LINE Developers の「あなたのユーザーID」から確認)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# === Webアプリ ===
APP_HOST=0.0.0.0
APP_PORT=8000
# 巡回間隔のデフォルト(秒)。config/sources.yaml の各ソースで上書き可能
DEFAULT_POLL_INTERVAL_SEC=900
